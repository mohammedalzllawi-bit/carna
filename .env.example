NODE_ENV=development
PORT=4100
DATABASE_URL=mongodb://127.0.0.1:27018/libya_auctions?replicaSet=libya-auctions-rs
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

DEFAULT_LOCALE=ar
DEFAULT_CURRENCY=LYD
CORS_ORIGINS=http://localhost:3100,http://localhost:3101

S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_BUCKET=vehicle-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
BRANDING_STORAGE_DIR=./storage/branding
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_DIR=./storage/media
CLOUDINARY_FOLDER=libya-auctions
# Firebase Push: keep the service account JSON outside this repository.
# FIREBASE_PROJECT_ID=karna-2ab13
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/firebase-service-account.json
# Optional when the local DNS resolver cannot resolve MongoDB Atlas SRV records.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name

# Resala SMS/OTP: server only. Keep the token and HMAC secret out of frontend builds.
RESALA_BASE_URL=https://dev.resala.ly/api/v1
RESALA_SERVICE_NAME=Carna
# RESALA_API_TOKEN=your-resala-api-token
# RESALA_OTP_SECRET=generate-a-random-secret-of-at-least-32-characters
# RESALA_AUTOFILL_HASH=your-android-app-signature-hash

PAYMENT_WEBHOOK_SECRET=change-me
ADMIN_API_KEY=change-this-long-random-admin-key
