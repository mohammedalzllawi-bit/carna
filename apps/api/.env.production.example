NODE_ENV=production
PORT=4100
DATABASE_URL=mongodb+srv://database-user:database-password@cluster.example.mongodb.net/libya_auctions
REDIS_URL=rediss://redis-user:redis-password@redis.example.net:6380
AUCTION_WORKER_MODE=redis
ALLOW_LEGACY_ADMIN_KEY=false

JWT_ACCESS_SECRET=replace-with-64-random-characters
JWT_REFRESH_SECRET=replace-with-another-64-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

DEFAULT_LOCALE=ar
DEFAULT_CURRENCY=LYD
CORS_ORIGINS=https://example.ly,https://admin.example.ly

S3_ENDPOINT=https://s3.example.net
S3_REGION=replace-with-storage-region
S3_BUCKET=replace-with-private-bucket-name
S3_ACCESS_KEY=replace-with-storage-access-key
S3_SECRET_KEY=replace-with-storage-secret-key

MEDIA_STORAGE_PROVIDER=cloudinary
CLOUDINARY_URL=cloudinary://replace-key:replace-secret@replace-cloud-name
# Instead of CLOUDINARY_URL, you can provide the three values below.
# CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
# CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
# CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
CLOUDINARY_FOLDER=libya-auctions-production

PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-secret

# Backend-only Firebase credentials. Mount the file through the hosting secret store.
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
RESALA_BASE_URL=https://dev.resala.ly/api/v1
RESALA_SERVICE_NAME=Carna
RESALA_API_TOKEN=replace-with-resala-api-token
RESALA_OTP_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
