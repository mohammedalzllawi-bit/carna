NODE_ENV=development
PORT=4100
DATABASE_URL=mongodb://127.0.0.1:27018/libya_auctions?replicaSet=libya-auctions-rs
REDIS_URL=redis://localhost:6379
AUCTION_WORKER_MODE=poll
ALLOW_LEGACY_ADMIN_KEY=false

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

DEFAULT_LOCALE=ar
DEFAULT_CURRENCY=LYD
CORS_ORIGINS=http://localhost:3100,http://localhost:3101

S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_BUCKET=vehicle-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
BRANDING_STORAGE_DIR=./storage/branding
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_DIR=./storage/media
CLOUDINARY_FOLDER=libya-auctions
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name

PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret
ADMIN_API_KEY=replace-with-a-long-random-admin-key
