{
  "name": "@libya-auctions/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "admin:bootstrap": "node --env-file=../../.env --require ./scripts/configure-dns.cjs scripts/bootstrap-admin.cjs",
    "db:upgrade": "node --env-file=../../.env scripts/upgrade-runtime.cjs",
    "test:integration": "npm run build && node --env-file=../../.env --require ./scripts/configure-dns.cjs --test test-integration/*.test.cjs",
    "dev": "node --env-file=../../.env --require ./scripts/configure-dns.cjs ../../node_modules/@nestjs/cli/bin/nest.js start",
    "dev:watch": "node --env-file=../../.env --require ./scripts/configure-dns.cjs ../../node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "nest build",
    "verify:runtime": "node scripts/verify-runtime.cjs",
    "prestart": "npm run verify:runtime",
    "start": "node --env-file-if-exists=../../.env --require ./scripts/configure-dns.cjs dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "npm run build && node --test \"test/**/*.test.cjs\"",
    "db:dev": "node scripts/mongodb-dev.cjs",
    "db:status": "node --env-file=../../.env --require ./scripts/configure-dns.cjs scripts/db-status.cjs",
    "prisma:generate": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js generate",
    "prisma:validate": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js validate",
    "prisma:push": "node --env-file=../../.env --require ./scripts/configure-dns.cjs ../../node_modules/prisma/build/index.js db push",
    "prisma:seed": "node --env-file=../../.env --require ./scripts/configure-dns.cjs -r ts-node/register prisma/seed.ts",
    "seed:demo": "node --env-file=../../.env --require ./scripts/configure-dns.cjs scripts/seed-demo.cjs"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/platform-socket.io": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/websockets": "^12.1.0",
    "@prisma/client": "^5.18.0",
    "argon2": "^0.41.1",
    "bullmq": "^6.3.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.11.0",
    "cookie": "^1.0.2",
    "firebase-admin": "^14.5.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@types/node": "^22.5.0",
    "eslint": "^9.9.0",
    "mongodb": "^7.5.0",
    "mongodb-memory-server": "^11.3.0",
    "prisma": "^5.18.0",
    "socket.io-client": "^4.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
