{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "24"
  },
  "steps": {
    "install": {
      "commands": ["MONGOMS_DISABLE_POSTINSTALL=1 npm ci --include=dev"]
    },
    "build": {
      "commands": ["npm run build --workspace @libya-auctions/admin"]
    }
  },
  "deploy": {
    "startCommand": "npm run admin:start"
  }
}
