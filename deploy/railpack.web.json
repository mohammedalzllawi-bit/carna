{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "24"
  },
  "steps": {
    "install": {
      "variables": {
        "MONGOMS_DISABLE_POSTINSTALL": "1"
      }
    },
    "build": {
      "commands": ["npm run build --workspace @libya-auctions/web"]
    }
  },
  "deploy": {
    "startCommand": "npm run web:start"
  }
}
