{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "24"
  },
  "buildAptPackages": ["...", "openssl"],
  "steps": {
    "install": {
      "deployOutputs": [],
      "variables": {
        "MONGOMS_DISABLE_POSTINSTALL": "1"
      }
    },
    "build": {
      "commands": ["npm run api:build"]
    }
  },
  "deploy": {
    "startCommand": "npm start",
    "aptPackages": ["...", "openssl"]
  }
}
